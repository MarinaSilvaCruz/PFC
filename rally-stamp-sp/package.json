{
  "name": "rally-stamp-sp",
  "version": "2.0.0",
  "private": true,
  "description": "Rally de carimbos não-oficial, feito por fãs, em São Paulo.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "tokens": "node scripts/gerar-tokens-css.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  }
}
