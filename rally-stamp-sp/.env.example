# Copie para .env e preencha. NUNCA versione o .env.

# Postgres (ex.: o que Railway/Render fornecem)
DATABASE_URL=postgres://rally:rally@localhost:5432/rally
# Defina como "true" quando o provedor exigir SSL no Postgres
DATABASE_SSL=false

PORT=3000
# URL pública do site, usada dentro dos QR codes (sem barra no final)
PUBLIC_URL=http://localhost:3000

# Token do painel /admin (gere algo longo e aleatório)
ADMIN_TOKEN=troque-isto

# Segredo para hash dos códigos de login (gere algo longo e aleatório)
CODE_SECRET=troque-isto-tambem

# E-mail transacional (Resend). Sem RESEND_API_KEY, o código é só impresso no console (modo dev).
RESEND_API_KEY=
EMAIL_FROM="Rally Stamp SP <nao-responda@seu-dominio.com>"

# Quantos proxies existem na frente do app (Railway/Render: 1)
TRUST_PROXY=1

# Tolerância extra (m) somada ao raio, limitada a este valor, de acordo com a precisão do GPS
GPS_TOLERANCIA_MAX_M=50
